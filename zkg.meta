[package]
description = Detect attempted and established MPTCP in standalone Zeek and clusters
tags = mptcp, tcp, detection, notices, zeek scripting
aliases = zeek-mptcp-detect
script_dir = scripts
depends =
    zeek >=8.0.0
    zkg >=2.12.0
test_command = python3 tests/run.py --load zeek-mptcp-detect
